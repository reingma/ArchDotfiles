# Identity (user.name / user.email) lives in ~/.gitconfig, which is not tracked.

[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictStyle = zdiff3

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[fetch]
	prune = true

[rerere]
	enabled = true

# Makes gh treat `origin` as the default repo everywhere (same key that
# `gh repo set-default` writes per repo). Side effect: `git remote` lists a
# URL-less `origin` in repos that have no remotes yet.
[remote "origin"]
	gh-resolved = base

[url "git@github.com:"]
	insteadOf = https://github.com/
